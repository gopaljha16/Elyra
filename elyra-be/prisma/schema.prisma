generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model test {
  id   String @id @default(cuid())
  name String
}

model User {
  id                 String             @id @default(cuid())
  clerkId            String             @unique

  // Basic info
  name               String
  age                Int
  gender             String
  bio                String?
  location           String
  latitude           Float?
  longitude          Float?

  // Profile photos (array of URLs from Supabase Storage)
  profilePhotos      String[]           @default([])
  primaryPhotoUrl    String?

  // Verification
  verificationSelfieUrl  String?
  verificationStatus     VerificationStatus @default(UNVERIFIED)
  verificationNote       String?          // reason if rejected
  verifiedAt             DateTime?
  liveVerifiedAt         DateTime?
  livePrimaryPhotoUrl    String?
  liveSessions           LiveSession[]

  // Matching data
  interests          String[]           @default([])
  personalityAnswers Json               @default("{}")
  preferences        Json               @default("{}")
  dateActivities     String[]           @default([])
  embedding          Unsupported("vector(1536)")?

  // Account status
  isActive           Boolean            @default(true)
  isOnboarded        Boolean            @default(false)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  matchesAsUser1     Match[]            @relation("User1Matches")
  matchesAsUser2     Match[]            @relation("User2Matches")
  feedbacks          Feedback[]
  verificationLogs   VerificationLog[]
  blocksMade         UserBlock[]         @relation("BlocksMade")
  blocksReceived     UserBlock[]         @relation("BlocksReceived")
  reportsMade        UserReport[]        @relation("ReportsMade")
  reportsReceived    UserReport[]        @relation("ReportsReceived")

  @@map("users")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model VerificationLog {
  id            String   @id @default(cuid())
  userId        String
  selfieUrl     String
  aiCheckPassed Boolean?
  aiReason      String?
  reviewedBy    String?  // "ai" or "admin"
  status        VerificationStatus
  createdAt     DateTime @default(now())

  failureReason     String?
  attemptIpHash     String?
  geminiRequestedAt DateTime?
  geminiImageBytes  Int?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([attemptIpHash, createdAt])
  @@index([geminiRequestedAt])

  @@map("verification_logs")
}

model Match {
  id                 String      @id @default(cuid())
  user1Id            String
  user2Id            String
  compatibilityScore Float
  status             MatchStatus @default(PENDING)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  pairKey            String?     @unique
  requestedById      String?
  acceptedByUser1    Boolean     @default(false)
  acceptedByUser2    Boolean     @default(false)

  user1      User       @relation("User1Matches", fields: [user1Id], references: [id])
  user2      User       @relation("User2Matches", fields: [user2Id], references: [id])
  datePlan   DatePlan?
  feedbacks  Feedback[]

  @@map("matches")
}

enum MatchStatus {
  PENDING
  ACTIVE
  COMPLETED
  REJECTED
}

model DatePlan {
  id          String   @id @default(cuid())
  matchId     String   @unique
  activities  Json
  totalBudget String
  duration    String
  vibe        String
  location    String
  generatedAt DateTime @default(now())
  activity    String?
  venueId     String?
  scheduledAt DateTime?
  proposalVersion Int @default(0)
  proposedById String?
  acceptedByUser1 Boolean @default(false)
  acceptedByUser2 Boolean @default(false)
  status      String @default("DRAFT")

  match Match @relation(fields: [matchId], references: [id])

  @@map("date_plans")
}

model Feedback {
  id             String   @id @default(cuid())
  matchId        String
  userId         String
  rating         Int?
  comfort        Int?
  enjoyment      Int?
  wouldMeetAgain Boolean?
  formVersion Int @default(1)
  review         String?
  successScore   Float?
  createdAt      DateTime @default(now())
  attended      Boolean?
  planVersion   Int @default(0)

  @@unique([matchId, userId, planVersion])

  match Match @relation(fields: [matchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@map("feedbacks")
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker User @relation("BlocksMade", fields: [blockerId], references: [id])
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id])
  @@id([blockerId, blockedId])
  @@map("user_blocks")
}

model UserReport {
  id String @id @default(cuid())
  reporterId String
  subjectId String
  reason String
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  disposition String?
  reviewerId String?
  reporter User @relation("ReportsMade", fields: [reporterId], references: [id])
  subject User @relation("ReportsReceived", fields: [subjectId], references: [id])
  @@index([resolvedAt, createdAt])
  @@map("user_reports")
}

model LiveSession {
  id String @id
  userId String
  primaryPhotoUrl String
  createdAt DateTime @default(now())
  completedAt DateTime?
  result String @default("PENDING")
  user User @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
  @@map("live_sessions")
}

model DatingEvent {
  kind String
  entity String
  version Int @default(0)
  occurredAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("occurred_at")
  @@id([kind, entity, version])
  @@map("dating_events")
}
